+/*---------------------------------------------------------------------------------------------
+ *  Copyright (c) Microsoft Corporation. All rights reserved.
+ *  Licensed under the MIT License. See License.txt in the project root for license information.
+ *--------------------------------------------------------------------------------------------*/
+
+import { createDecorator } from '../../../../platform/instantiation/common/instantiation.js';
+import { Event, Emitter } from '../../../../base/common/event.js';
+import { IProductService } from '../../../../platform/product/common/productService.js';
+
+// ─── 项目编号数据模型 ──────────
+
+export interface IProjectNumberItem {
+	readonly number: string;      // 如 "Z992232-2463"（完整 taskKey）
+	readonly label: string;       // 同 number
+	readonly description?: string; // 如 "html 报告创建skill"（taskName）
+}
+
+// ─── 服务接口 ──────────
+
+export const IProjectNumberService = createDecorator<IProjectNumberService>('projectNumberService');
+
+export interface IProjectNumberService {
+	readonly _serviceBrand: undefined;
+	readonly onDidLoad: Event<void>;
+	readonly isAvailable: boolean;
+	getItems(): IProjectNumberItem[];                     // 返回缓存数据（同步）
+	loadItems(): Promise<IProjectNumberItem[]>;           // 从 API 加载
+}
+
+// ─── API 实现 ──────────
+
+export class ProjectNumberService implements IProjectNumberService {
+	declare readonly _serviceBrand: undefined;
+
+	private readonly _onDidLoad = new Emitter<void>();
+	readonly onDidLoad = this._onDidLoad.event;
+
+	private _items: IProjectNumberItem[] = [];
+
+	constructor(
+		@IProductService private readonly _productService: IProductService,
+	) {}
+
+	get isAvailable(): boolean {
+		return this._items.length > 0;
+	}
+
+	getItems(): IProjectNumberItem[] {
+		return this._items;
+	}
+
+	async loadItems(): Promise<IProjectNumberItem[]> {
+		try {
+			const endpoint = this._productService.kanbanEndpoint || '/api/kanban/tasks';
+			const response = await fetch(endpoint, {
+				credentials: 'same-origin',
+			});
+			if (!response.ok) {
+				return [];
+			}
+			const json = await response.json() as {
+				returnCode?: string;
+				data?: { tasks?: Array<{ taskKey: string; taskName: string }> };
+			};
+			if (json.returnCode !== 'SUC0000' || !json.data?.tasks) {
+				this._items = [];
+				return [];
+			}
+			this._items = json.data.tasks.map(task => ({
+				number: task.taskKey,
+				label: task.taskKey,
+				description: task.taskName,
+			}));
+			this._onDidLoad.fire();
+			return this._items;
+		} catch {
+			this._items = [];
+			return [];
+		}
+	}
+}
