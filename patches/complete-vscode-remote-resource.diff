+// 文件访问控制共享模块：路径解析 + 白名单。
+// 供 RemoteAgentFileSystemProviderChannel（IPC 通道）与
+// RemoteExtensionHostAgentServer（HTTP /vscode-remote-resource 端点）复用。
+
+import { realpath, readFile, access, constants } from 'fs/promises';
+import { dirname, join, resolve } from 'path';
+
+//#region resolveRealPath
+
+/**
+ * 解析真实路径：逐段解析，与内核路径解析语义一致
+ * —— 每个存在的段都经 realpath 解析（软链接解析后再处理后续 ..），
+ * —— 遇到第一个不存在的段后，剩余尾部原样拼接（覆盖新建文件场景）。
+ * 不能先做字符串层面的 .. 规范化：若 .. 前面是软链接，字符串抵消的结果
+ * 与内核实际落点不一致，会留下绕过空间。
+ * 仅 ENOENT 触发尾部回退，其余错误直接抛出（fail-close）
+ */
+export async function resolveRealPath(p: string): Promise<string> {
+	const abs = p.startsWith('/') ? p : resolve(p);
+	const segments = abs.split('/').filter(s => s !== '' && s !== '.');
+	let current = '/';
+	const tail: string[] = [];
+	for (const seg of segments) {
+		if (tail.length > 0) {
+			// 已进入不存在的尾部区域，剩余段（含 ..）原样保留
+			tail.push(seg);
+			continue;
+		}
+		if (seg === '..') {
+			// 内核语义：.. 相对于软链接解析后的真实路径向上一级
+			current = dirname(current);
+			continue;
+		}
+		const candidate = join(current, seg);
+		try {
+			current = await realpath(candidate);
+		} catch (e) {
+			if ((e as NodeJS.ErrnoException).code !== 'ENOENT') {
+				throw e;
+			}
+			tail.push(seg);
+		}
+	}
+	return tail.length > 0 ? join(current, ...tail) : current;
+}
+
+//#endregion
+
+//#region FileAccessWhitelist
+
+/**
+ * 文件访问白名单单例：从 config/whiteFiles 加载，供 IPC 与 HTTP 端点共享。
+ * 进程内只加载一次，后续调用 ensureLoaded() 直接返回。
+ */
+export class FileAccessWhitelist {
+
+	private paths: string[] = [];
+	private loadPromise: Promise<void> | null = null;
+	private loaded = false;
+
+	/**
+	 * 启动时加载白名单配置文件。
+	 * @param releaseRoot 发布包根目录（appRoot 回退两级）
+	 */
+	load(releaseRoot: string): void {
+		if (this.loadPromise) {
+			return; // 已在加载中或已加载完成
+		}
+		this.loadPromise = this._doLoad(releaseRoot);
+	}
+
+	/**
+	 * 等待加载完成。
+	 */
+	async waitUntilLoaded(): Promise<void> {
+		if (this.loaded) {
+			return;
+		}
+		if (this.loadPromise) {
+			await this.loadPromise;
+		}
+	}
+
+	/**
+	 * 检查路径是否命中白名单（精确匹配文件或目录前缀匹配）。
+	 * @param realPath 已解析软链接后的真实路径
+	 */
+	isWhitelisted(realPath: string): boolean {
+		if (this.paths.length === 0) {
+			return false;
+		}
+		const normalized = realPath.endsWith('/') ? realPath.slice(0, -1) : realPath;
+		for (const whitelist of this.paths) {
+			const normalizedWhitelist = whitelist.endsWith('/') ? whitelist.slice(0, -1) : whitelist;
+			if (normalized === normalizedWhitelist || normalized.startsWith(normalizedWhitelist + '/')) {
+				return true;
+			}
+		}
+		return false;
+	}
+
+	/**
+	 * 白名单是否为空（未配置或加载失败）。
+	 */
+	isEmpty(): boolean {
+		return this.paths.length === 0;
+	}
+
+	private async _doLoad(releaseRoot: string): Promise<void> {
+		const configPath = join(releaseRoot, 'config', 'whiteFiles');
+		try {
+			await access(configPath, constants.R_OK);
+			const content = await readFile(configPath, 'utf-8');
+			this.paths = content.split('\n')
+				.map(line => line.trim())
+				.filter(line => line.length > 0 && !line.startsWith('#'));
+			this.loaded = true;
+			console.log(`[Auth] Whitelist: loaded ${this.paths.length} entries from ${configPath}`);
+		} catch (e) {
+			if ((e as NodeJS.ErrnoException).code === 'ENOENT') {
+				console.log(`[Auth] Whitelist: config file not found at ${configPath}, whitelist disabled`);
+			} else {
+				console.error(`[Auth] Whitelist: failed to load config from ${configPath}: ${(e as Error).message}`);
+			}
+			this.paths = [];
+			this.loaded = true;
+		}
+	}
+}
+
+/**
+ * 进程级白名单单例，供 IPC 通道与 HTTP 端点共享。
+ */
+export const fileWhitelist = new FileAccessWhitelist();
+
+//#endregion
