+	/**
+	 * /vscode-remote-resource 端点路径鉴权：
+	 * 1. 白名单放行（config/whiteFiles 配置的路径，含扩展目录、NLS 缓存等）
+	 * 2. 会话 artifacts 目录放行（需 sessionID/idToken 鉴权）
+	 * 3. 其他路径一律拒绝（fail-close）
+	 */
+	private async _checkRemoteResourceAccess(req: http.IncomingMessage, filePath: string): Promise<boolean> {
+		// 1. 解析真实路径（防软链接/.. 逃逸）
+		let realPath: string;
+		try {
+			realPath = await resolveRealPath(filePath);
+		} catch {
+			this._logService.error(`[RemoteResource] Failed to resolve real path: ${filePath}`);
+			return false; // fail-close
+		}
+
+		// 2. 白名单检查
+		await fileWhitelist.waitUntilLoaded();
+		if (fileWhitelist.isWhitelisted(realPath)) {
+			return true;
+		}
+
+		// 3. 会话 artifacts 目录检查
+		const cookies = cookie.parse(req.headers.cookie || '');
+		const sessionID = cookies['session_id'];
+		const idToken = cookies['id_token'];
+		const runEnv = cookies['run_env'] || 'dev';
+
+		if (!sessionID || !idToken) {
+			this._logService.info(`[RemoteResource] Access denied for ${filePath}: missing session credentials`);
+			return false;
+		}
+
+		try {
+			const artifactsPath = await getArtifactsPath(sessionID, idToken, runEnv);
+			const normalizedPath = realPath.endsWith('/') ? realPath.slice(0, -1) : realPath;
+			const normalizedAllowed = artifactsPath.endsWith('/') ? artifactsPath.slice(0, -1) : artifactsPath;
+			const allowed = normalizedPath === normalizedAllowed
+				|| normalizedPath.startsWith(normalizedAllowed + '/');
+			if (!allowed) {
+				this._logService.info(`[RemoteResource] Access denied: ${filePath} (resolved: ${realPath}) outside artifacts ${artifactsPath}`);
+			}
+			return allowed;
+		} catch (e) {
+			this._logService.error(`[RemoteResource] Auth check failed for ${filePath}: ${(e as Error).message}`);
+			return false; // fail-close
+		}
+	}
