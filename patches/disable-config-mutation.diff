 	async writeFile(resource: URI, bufferOrReadableOrStream: VSBuffer | VSBufferReadable | VSBufferReadableStream, options?: IWriteFileOptions): Promise<IFileStatWithMetadata> {
+		// [disable-config-mutation] Reject writes to configuration files (settings/keybindings/tasks/mcp/extensions).
+		const configFiles = ['settings.json', 'keybindings.json', 'tasks.json', 'mcp.json', 'extensions.json'];
+		if (configFiles.some(f => resource.path.toLowerCase().endsWith('/' + f))) {
+			throw new FileOperationError(localize('err.readonlyConfig', "Unable to write file '{0}' because it is a read-only configuration resource", this.resourceForError(resource)), FileOperationResult.FILE_PERMISSION_DENIED, options);
+		}
+
 		const provider = this.throwIfFileSystemIsReadonly(await this.withWriteProvider(resource), resource);
 		const { providerExtUri } = this.getExtUri(provider);
 
