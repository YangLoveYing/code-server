+import { CancellationToken } from '../../base/common/cancellation.js';
+import { Event } from '../../base/common/event.js';
+import { IServerChannel } from '../../base/parts/ipc/common/ipc.js';
+import { RemoteAgentConnectionContext } from '../../platform/remote/common/remoteAgentEnvironment.js';
+
+/**
+ * IPC commands that only query state or modify metadata of extensions already
+ * installed on the server. Everything else (uploading, installing, downloading,
+ * copying or removing extensions) is rejected so web users cannot introduce
+ * executable code into the extension host.
+ *
+ * Preinstalled extensions and administrator-driven CLI installs do not travel
+ * through this channel, so they keep working.
+ *
+ * The list is an allowlist on purpose: any command added upstream later is
+ * blocked by default instead of being exposed accidentally.
+ */
+const ALLOWED_COMMANDS = new Set<string>([
+	'getManifest',
+	'getTargetPlatform',
+	'getInstalled',
+	'toggleApplicationScope',
+	'updateMetadata',
+	'getExtensionsControlManifest',
+	'getConfigBasedTips',
+	'getImportantExecutableBasedTips',
+	'getOtherExecutableBasedTips',
+]);
+
+/**
+ * Wraps the ExtensionManagementChannel and denies every command that is not in
+ * {@link ALLOWED_COMMANDS}. Event subscriptions are forwarded unchanged.
+ */
+export class RestrictedExtensionManagementChannel implements IServerChannel<RemoteAgentConnectionContext> {
+
+	constructor(private readonly actual: IServerChannel<RemoteAgentConnectionContext | string>) { }
+
+	listen<T>(context: RemoteAgentConnectionContext, event: string, arg?: any): Event<T> {
+		return this.actual.listen<T>(context, event, arg);
+	}
+
+	async call<T>(context: RemoteAgentConnectionContext, command: string, arg?: any, cancellationToken?: CancellationToken): Promise<T> {
+		if (!ALLOWED_COMMANDS.has(command)) {
+			throw new Error(`Extension management command '${command}' is disabled by administrator policy`);
+		}
+		return this.actual.call<T>(context, command, arg, cancellationToken);
+	}
+}
