+	private handleUrlFilePath(): void {
+		const urlParams = new URLSearchParams(window.location.search);
+		const filePath = urlParams.get('filePath');
+		const folder = urlParams.get('folder') || undefined;
+		if (filePath) {
+			this.openFile(filePath, folder);
+		}
+	}
+
+	private async openFile(filePath: string, folder?: string): Promise<void> {
+		try {
+			const workspace = this.contextService.getWorkspace();
+			if (!workspace.folders || workspace.folders.length === 0) {
+				this.logService.warn('[CodeServerClient] No workspace folder found, waiting for workspace to load');
+				this.waitForWorkspaceAndOpenFile(filePath, folder);
+				return;
+			}
+
+			const workspaceFolderUri = workspace.folders[0].uri;
+			let targetUri: URI;
+
+			const normalizedFilePath = this.normalizePath(filePath);
+
+			if (folder) {
+				const normalizedFolder = this.normalizePath(folder);
+				let folderUri: URI;
+
+				if (normalizedFolder.startsWith('/')) {
+					folderUri = URI.from({
+						scheme: workspaceFolderUri.scheme,
+						authority: workspaceFolderUri.authority,
+						path: normalizedFolder
+					});
+				} else {
+					folderUri = joinPath(workspaceFolderUri, normalizedFolder);
+				}
+
+				targetUri = joinPath(folderUri, normalizedFilePath.replace(/^\//, ''));
+			} else {
+				targetUri = joinPath(workspaceFolderUri, normalizedFilePath.replace(/^\//, ''));
+			}
+
+			this.logService.info(`[CodeServerClient] Opening file: ${targetUri.toString()}`);
+			await this.commandService.executeCommand('vscode.open', targetUri);
+		} catch (error) {
+			this.logService.error('[CodeServerClient] Failed to open file:', error);
+		}
+	}
+
+	private waitForWorkspaceAndOpenFile(filePath: string, folder?: string): void {
+		const disposable = this.contextService.onDidChangeWorkspaceFolders(() => {
+			disposable.dispose();
+			this.openFile(filePath, folder);
+		});
+		this._register(disposable);
+	}
+
+	private normalizePath(path: string): string {
+		let normalized = path.replace(/\\/g, '/');
+		normalized = normalized.replace(/^[A-Za-z]:/, '');
+		if (!normalized.startsWith('/')) {
+			normalized = '/' + normalized;
+		}
+		return normalized;
+	}
