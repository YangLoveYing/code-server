+	 * 接口：POST /api/v1/fileMng/skill/skill-last-modified
+	 */
+	private recordSkillFileChange(runEnv: string, sessionID: string, skillName: string, idToken: string): void {
+		const baseUrl = ENV_SERVICE_URLS[runEnv];
+		if (!baseUrl) {
+			this.logService.error(`[SkillTracker] Unknown run_env: ${runEnv}`);
+			return;
+		}
+
+		const url = `${baseUrl}/api/v1/fileMng/skill/skill-last-modified`;
+		const postData = JSON.stringify({ sessionId: sessionID, skillName });
+
+		const req = https.request(url, {
+			method: 'POST',
+			headers: {
+				'Id-Token': idToken,
+				'Content-Type': 'application/json',
+				'Content-Length': Buffer.byteLength(postData)
+			},
+			timeout: 10000,
+			rejectUnauthorized: false,
+			secureOptions: cryptoConstants.SSL_OP_ALLOW_UNSAFE_LEGACY_RENEGOTIATION | cryptoConstants.SSL_OP_LEGACY_SERVER_CONNECT,
+		}, (res) => {
+			let data = '';
+			res.on('data', (chunk: Buffer) => { data += chunk.toString(); });
+			res.on('end', () => {
+				if (res.statusCode !== 200) {
+					this.logService.error(`[SkillTracker] API request failed with status ${res.statusCode}: ${data}`);
+				}
+			});
+		});
+
+		req.on('error', (e: Error) => {
+			this.logService.error(`[SkillTracker] API request failed: ${e.message}`);
+		});
+
+		req.on('timeout', () => {
+			req.destroy();
+			this.logService.error('[SkillTracker] API request timed out');
+		});
+
+		req.write(postData);
+		req.end();
+	}
+
