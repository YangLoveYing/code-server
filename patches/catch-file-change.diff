+	//#region Auth: Cache helpers
+
+	private getCachedArtifactsPath(sessionID: string): string | null {
+		const entry = this.authCache.get(sessionID);
+		if (entry && entry.expireAt > Date.now()) {
+			return entry.artifactsPath;
+		}
+		this.authCache.delete(sessionID);
+		return null;
+	}
+
+	private setCachedArtifactsPath(sessionID: string, artifactsPath: string): void {
+		this.authCache.set(sessionID, { artifactsPath, expireAt: Date.now() + AUTH_CACHE_TTL });
+	}
