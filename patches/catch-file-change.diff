+	private recordFileChange(runEnv: string, sessionID: string, idToken: string, filePath: string): void {
+		const baseUrl = ENV_SERVICE_URLS[runEnv];
+		if (!baseUrl) {
+			this.logService.error(`[FileTracker] Unknown run_env: ${runEnv}`);
+			return;
+		}
+
+		const url = `${baseUrl}/api/v1/backendPromptMng/backend-prompts`;
+		const postData = JSON.stringify({
+			data: [{
+				sessionId: sessionID,
+				content: `${filePath} 文件内容发生变化`,
+				origin: 'code-server',
+				type: 'fileChange'
+			}]
+		});
+
+		const req = http.request(url, {
+			method: 'POST',
+			headers: {
+				'Id-Token': idToken,
+				'Content-Type': 'application/json',
+				'Content-Length': Buffer.byteLength(postData)
+			},
+			timeout: 10000
+		}, (res) => {
+			let data = '';
+			res.on('data', (chunk: Buffer) => { data += chunk.toString(); });
+			res.on('end', () => {
+				if (res.statusCode !== 200) {
+					this.logService.error(`[FileTracker] API request failed with status ${res.statusCode}: ${data}`);
+				}
+			});
+		});
+
+		req.on('error', (e: Error) => {
+			this.logService.error(`[FileTracker] API request failed: ${e.message}`);
+		});
+
+		req.on('timeout', () => {
+			req.destroy();
+			this.logService.error('[FileTracker] API request timed out');
+		});
+
+		req.write(postData);
+		req.end();
+	}
+
