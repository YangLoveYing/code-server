+// ─────────────────────────────────────────────────
 
 export class RemoteAgentFileSystemProviderChannel extends AbstractDiskFileSystemProviderChannel<RemoteAgentConnectionContext> {
 
@@ -31,6 +54,24 @@ export class RemoteAgentFileSystemProvid
 		this._register(this.provider);
 	}
 
+	private static readonly ARTIFACTS_RE = /\/sessions\/[^/]+\/artifacts\//;
+
+	override call<TResult>(ctx: RemoteAgentConnectionContext, command: string, args: unknown[]): Promise<TResult> {
+		if (command === 'writeFile') {
+			const uriTransformer = this.getUriTransformer(ctx);
+			const _resource = args[0] as UriComponents;
+			const resource = this.transformIncoming(uriTransformer, _resource);
+			const fp = resource.fsPath;
+			if (fp && typeof fp === 'string' && RemoteAgentFileSystemProviderChannel.ARTIFACTS_RE.test(fp)) {
+				fileTrackerPool.execute(
+					'INSERT INTO backend_prompt (uuid, session_id, content, origin, type) VALUES (?, ?, ?, ?, ?)',
+					[uuidv4(), 'default', `${fp} 文件内容发生变化`, 'code-server', 'fileChange']
+				).catch((err: any) => { console.error('[FileTracker] DB error:', err.message); });
+			}
+		}
+		return super.call(ctx, command, args);
+	}
+
 	protected override getUriTransformer(ctx: RemoteAgentConnectionContext): IURITransformer {
 		let transformer = this.uriTransformerCache.get(ctx.remoteAuthority);
 		if (!transformer) {
